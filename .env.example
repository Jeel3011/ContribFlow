# ContribFlow Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Required ─────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (classic)
# Needs scope: public_repo (for public repos) or repo (for private)
# Get it at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Required for Stage 1 (LLM gap analysis), Stage 2 (verification),
# Stage 3 (impact analysis), Stage 4 (pre-PR review)
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── Optional ─────────────────────────────────────────────────────────────────

# Override the default OpenAI API base URL (e.g., for Azure OpenAI)
# OPENAI_API_BASE=https://your-deployment.openai.azure.com/

# FastAPI backend port (default: 8000)
# API_PORT=8000

# Streamlit frontend port (default: 8501)
# STREAMLIT_PORT=8501
